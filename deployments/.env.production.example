# 应用
APP_ENV=production
APP_NAME=cash
APP_VERSION=1.0.0
API_TIMEZONE=Asia/Shanghai
JWT_ISSUER=cash-core
# 用 `openssl rand -base64 48` 生成，不要提交到 Git。
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h
HTTP_ALLOWED_ORIGINS=*
LOG_LEVEL=info
LOG_FORMAT=json
LOG_TIMEZONE=Asia/Shanghai

# SQLite 数据保存在 VPS 的项目目录，便于备份和迁移。启动前请创建此目录并将其所有者设为 65532:65532。
SQLITE_DATA_DIR=/root/cash-core/data
# 由 /root/caddy 全局 Caddy 项目创建的外部 Docker 网络。
CADDY_PROXY_NETWORK=caddy_proxy
