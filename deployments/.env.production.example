# 域名与证书通知邮箱
DOMAIN=your-domain.com
ACME_EMAIL=your-email@example.com

# 应用
APP_IMAGE=elytherivian/cash-core
# main 分支使用 latest；也可以固定为 1.2.3 或 sha-<commit> 以便精确发布和回滚。
IMAGE_TAG=latest
APP_ENV=production
APP_NAME=cash
# 建议与 IMAGE_TAG 保持一致，用于 API 响应版本标识。
APP_VERSION=latest
API_TIMEZONE=Asia/Shanghai
JWT_ISSUER=cash-core
# 用 `openssl rand -base64 48` 生成，不要提交到 Git。
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h
HTTP_ALLOWED_ORIGINS=*
LOG_LEVEL=info
LOG_FORMAT=json
LOG_TIMEZONE=Asia/Shanghai

# SQLite 数据保存在 Docker 命名卷 sqlite_data，无需数据库账号或密码。
