# 域名与证书通知邮箱
DOMAIN=dash-rn.elytherivian.top
ACME_EMAIL=your-email@example.com

# 应用
APP_ENV=production
APP_NAME=cash
APP_VERSION=1.0.0
API_TIMEZONE=Asia/Shanghai
JWT_ISSUER=cash-core
# 用 `openssl rand -base64 48` 生成，不要提交到 Git。
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h
HTTP_ALLOWED_ORIGINS=*
LOG_LEVEL=info
LOG_FORMAT=json
LOG_TIMEZONE=Asia/Shanghai

# PostgreSQL（仅 Docker 内网可访问）
DB_NAME=cash
DB_USER=cash
# 用 `openssl rand -hex 32` 生成，不要提交到 Git。
DB_PASSWORD=replace-with-a-random-hex-password
DB_SSLMODE=disable
