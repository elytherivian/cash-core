# CI 只发布两个移动标签：codex/dev 对应 dev，main 对应 latest。
# 生产环境使用 main 构建的 latest；不要在此使用 dev。
APP_IMAGE=your-dockerhub-user/cash-core:latest
APP_ENV=production
APP_NAME=cash
# 这是 API 展示的源码版本，不决定 Docker 镜像标签。
APP_VERSION=1.0.0
API_TIMEZONE=Asia/Shanghai
JWT_ISSUER=cash-core
# 用 `openssl rand -base64 48` 生成，不要提交到 Git。
JWT_SECRET=replace-with-a-random-secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h
HTTP_ALLOWED_ORIGINS=*
LOG_LEVEL=info
LOG_FORMAT=json
LOG_TIMEZONE=Asia/Shanghai

# SQLite 使用宿主机 bind mount，容器内文件固定为 /data/cash.db。
SQLITE_DATA_DIR=/root/cash-core/data

# 必须与 /root/caddy 中全局 Caddy 加入的外部 Docker 网络一致。
CADDY_PROXY_NETWORK=caddy_proxy
